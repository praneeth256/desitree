rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Videos - public read, authenticated write with restrictions
    match /videos/{videoId} {
      allow read: if true;
      
      // Only admin can create (upload) videos
      allow create: if request.auth != null && request.auth.token.email == 'admin@desitree.com';
      
      // Any logged-in user can update views, likes, comments
      allow update: if request.auth != null && (
        // View increment
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
         request.resource.data.views == resource.data.views + 1) ||
        // Comment added
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments']) &&
         request.resource.data.comments.size() == resource.data.comments.size() + 1) ||
        // Like/unlike
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])) ||
        // Admin can update anything
        request.auth.token.email == 'admin@desitree.com'
      );
      
      // Only admin can delete
      allow delete: if request.auth != null && request.auth.token.email == 'admin@desitree.com';
    }
    
    // Contacts - any authenticated user can create, only admin can read
    match /contacts/{contactId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && request.auth.token.email == 'admin@desitree.com';
    }
  }
}
