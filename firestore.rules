rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Videos - anyone can read
    // Admin can create/delete (client-side check enforces this)
    // Anyone can increment views only (by exactly 1)
    match /videos/{videoId} {
      allow read: if true;
      allow create, delete: if request.auth != null;

      // Allow view increment: only the 'views' field can change
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
        && request.resource.data.views == resource.data.views + 1;
    }

    // Comments - anyone authenticated can add, anyone can read
    match /videos/{videoId}/comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
    }

    // Contacts / DMCA submissions - any authenticated user can submit
    // Any authenticated user can read (client-side admin check protects UI)
    match /contacts/{contactId} {
      allow read, create: if request.auth != null;
    }
  }
}
